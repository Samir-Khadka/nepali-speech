# Copy to .env and adjust. Defaults work for local dev.
# SQLite file under DATA_DIR; any SQLAlchemy URL works (Postgres-ready).
DATABASE_URL=sqlite:///./data/nepali-speech.db
# Data root: audio goes to <DATA_DIR>/audio, DB defaults to <DATA_DIR>/nepali-speech.db
DATA_DIR=./data
# Comma-separated admin emails allowed on /api/admin/* via X-Admin-Email header.
ADMIN_EMAILS=admin@example.com
PORT=8000
